theorem linearB2 : ∀ x p q z : F2, Eqv (cubic2 x (add2 p q) z) (add2 (cubic2 x p z) (cubic2 x q z)) := (F2.rec (motive := fun x => ∀ p q z : F2, Eqv (cubic2 x (add2 p q) z) (add2 (cubic2 x p z) (cubic2 x q z))) ((F2.rec (motive := fun p => ∀ q z : F2, Eqv (cubic2 F2.v0 (add2 p q) z) (add2 (cubic2 F2.v0 p z) (cubic2 F2.v0 q z))) ((F2.rec (motive := fun q => ∀ z : F2, Eqv (cubic2 F2.v0 (add2 F2.v0 q) z) (add2 (cubic2 F2.v0 F2.v0 z) (cubic2 F2.v0 q z))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v0 (add2 F2.v0 F2.v0) z) (add2 (cubic2 F2.v0 F2.v0 z) (cubic2 F2.v0 F2.v0 z))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v0 (add2 F2.v0 F2.v1) z) (add2 (cubic2 F2.v0 F2.v0 z) (cubic2 F2.v0 F2.v1 z))) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun q => ∀ z : F2, Eqv (cubic2 F2.v0 (add2 F2.v1 q) z) (add2 (cubic2 F2.v0 F2.v1 z) (cubic2 F2.v0 q z))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v0 (add2 F2.v1 F2.v0) z) (add2 (cubic2 F2.v0 F2.v1 z) (cubic2 F2.v0 F2.v0 z))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v0 (add2 F2.v1 F2.v1) z) (add2 (cubic2 F2.v0 F2.v1 z) (cubic2 F2.v0 F2.v1 z))) (Eqv.refl) (Eqv.refl))))))) ((F2.rec (motive := fun p => ∀ q z : F2, Eqv (cubic2 F2.v1 (add2 p q) z) (add2 (cubic2 F2.v1 p z) (cubic2 F2.v1 q z))) ((F2.rec (motive := fun q => ∀ z : F2, Eqv (cubic2 F2.v1 (add2 F2.v0 q) z) (add2 (cubic2 F2.v1 F2.v0 z) (cubic2 F2.v1 q z))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v1 (add2 F2.v0 F2.v0) z) (add2 (cubic2 F2.v1 F2.v0 z) (cubic2 F2.v1 F2.v0 z))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v1 (add2 F2.v0 F2.v1) z) (add2 (cubic2 F2.v1 F2.v0 z) (cubic2 F2.v1 F2.v1 z))) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun q => ∀ z : F2, Eqv (cubic2 F2.v1 (add2 F2.v1 q) z) (add2 (cubic2 F2.v1 F2.v1 z) (cubic2 F2.v1 q z))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v1 (add2 F2.v1 F2.v0) z) (add2 (cubic2 F2.v1 F2.v1 z) (cubic2 F2.v1 F2.v0 z))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 F2.v1 (add2 F2.v1 F2.v1) z) (add2 (cubic2 F2.v1 F2.v1 z) (cubic2 F2.v1 F2.v1 z))) (Eqv.refl) (Eqv.refl))))))))
theorem linearC2 : ∀ x y p q : F2, Eqv (cubic2 x y (add2 p q)) (add2 (cubic2 x y p) (cubic2 x y q)) := (F2.rec (motive := fun x => ∀ y p q : F2, Eqv (cubic2 x y (add2 p q)) (add2 (cubic2 x y p) (cubic2 x y q))) ((F2.rec (motive := fun y => ∀ p q : F2, Eqv (cubic2 F2.v0 y (add2 p q)) (add2 (cubic2 F2.v0 y p) (cubic2 F2.v0 y q))) ((F2.rec (motive := fun p => ∀ q : F2, Eqv (cubic2 F2.v0 F2.v0 (add2 p q)) (add2 (cubic2 F2.v0 F2.v0 p) (cubic2 F2.v0 F2.v0 q))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v0 F2.v0 (add2 F2.v0 q)) (add2 (cubic2 F2.v0 F2.v0 F2.v0) (cubic2 F2.v0 F2.v0 q))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v0 F2.v0 (add2 F2.v1 q)) (add2 (cubic2 F2.v0 F2.v0 F2.v1) (cubic2 F2.v0 F2.v0 q))) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun p => ∀ q : F2, Eqv (cubic2 F2.v0 F2.v1 (add2 p q)) (add2 (cubic2 F2.v0 F2.v1 p) (cubic2 F2.v0 F2.v1 q))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v0 F2.v1 (add2 F2.v0 q)) (add2 (cubic2 F2.v0 F2.v1 F2.v0) (cubic2 F2.v0 F2.v1 q))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v0 F2.v1 (add2 F2.v1 q)) (add2 (cubic2 F2.v0 F2.v1 F2.v1) (cubic2 F2.v0 F2.v1 q))) (Eqv.refl) (Eqv.refl))))))) ((F2.rec (motive := fun y => ∀ p q : F2, Eqv (cubic2 F2.v1 y (add2 p q)) (add2 (cubic2 F2.v1 y p) (cubic2 F2.v1 y q))) ((F2.rec (motive := fun p => ∀ q : F2, Eqv (cubic2 F2.v1 F2.v0 (add2 p q)) (add2 (cubic2 F2.v1 F2.v0 p) (cubic2 F2.v1 F2.v0 q))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v1 F2.v0 (add2 F2.v0 q)) (add2 (cubic2 F2.v1 F2.v0 F2.v0) (cubic2 F2.v1 F2.v0 q))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v1 F2.v0 (add2 F2.v1 q)) (add2 (cubic2 F2.v1 F2.v0 F2.v1) (cubic2 F2.v1 F2.v0 q))) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun p => ∀ q : F2, Eqv (cubic2 F2.v1 F2.v1 (add2 p q)) (add2 (cubic2 F2.v1 F2.v1 p) (cubic2 F2.v1 F2.v1 q))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v1 F2.v1 (add2 F2.v0 q)) (add2 (cubic2 F2.v1 F2.v1 F2.v0) (cubic2 F2.v1 F2.v1 q))) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun q => Eqv (cubic2 F2.v1 F2.v1 (add2 F2.v1 q)) (add2 (cubic2 F2.v1 F2.v1 F2.v1) (cubic2 F2.v1 F2.v1 q))) (Eqv.refl) (Eqv.refl))))))))
theorem cubic2_nonzero : Eqv (cubic2 F2.v1 F2.v1 F2.v1) F2.v0 → Void := neq2_1_0
theorem cubic2_invariant : ∀ x y z : F2, Eqv (cubic2 (neg2 x) (neg2 y) (neg2 z)) (cubic2 x y z) := (F2.rec (motive := fun x => ∀ y z : F2, Eqv (cubic2 (neg2 x) (neg2 y) (neg2 z)) (cubic2 x y z)) ((F2.rec (motive := fun y => ∀ z : F2, Eqv (cubic2 (neg2 F2.v0) (neg2 y) (neg2 z)) (cubic2 F2.v0 y z)) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v0) (neg2 F2.v0) (neg2 z)) (cubic2 F2.v0 F2.v0 z)) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v0) (neg2 F2.v1) (neg2 z)) (cubic2 F2.v0 F2.v1 z)) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun y => ∀ z : F2, Eqv (cubic2 (neg2 F2.v1) (neg2 y) (neg2 z)) (cubic2 F2.v1 y z)) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v1) (neg2 F2.v0) (neg2 z)) (cubic2 F2.v1 F2.v0 z)) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v1) (neg2 F2.v1) (neg2 z)) (cubic2 F2.v1 F2.v1 z)) (Eqv.refl) (Eqv.refl))))))
theorem characteristic_two_fails (h : NoTwoTorsion core2) : Void := neq2_1_0 (h F2.v1 Eqv.refl)
end CubicGate
