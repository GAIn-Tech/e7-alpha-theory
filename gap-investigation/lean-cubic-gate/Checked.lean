theorem cubic2_nonzero : Eqv (cubic2 F2.v1 F2.v1 F2.v1) F2.v0 → Void := neq2_1_0
theorem cubic2_invariant : ∀ x y z : F2, Eqv (cubic2 (neg2 x) (neg2 y) (neg2 z)) (cubic2 x y z) := (F2.rec (motive := fun x => ∀ y z : F2, Eqv (cubic2 (neg2 x) (neg2 y) (neg2 z)) (cubic2 x y z)) ((F2.rec (motive := fun y => ∀ z : F2, Eqv (cubic2 (neg2 F2.v0) (neg2 y) (neg2 z)) (cubic2 F2.v0 y z)) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v0) (neg2 F2.v0) (neg2 z)) (cubic2 F2.v0 F2.v0 z)) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v0) (neg2 F2.v1) (neg2 z)) (cubic2 F2.v0 F2.v1 z)) (Eqv.refl) (Eqv.refl))))) ((F2.rec (motive := fun y => ∀ z : F2, Eqv (cubic2 (neg2 F2.v1) (neg2 y) (neg2 z)) (cubic2 F2.v1 y z)) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v1) (neg2 F2.v0) (neg2 z)) (cubic2 F2.v1 F2.v0 z)) (Eqv.refl) (Eqv.refl))) ((F2.rec (motive := fun z => Eqv (cubic2 (neg2 F2.v1) (neg2 F2.v1) (neg2 z)) (cubic2 F2.v1 F2.v1 z)) (Eqv.refl) (Eqv.refl))))))
