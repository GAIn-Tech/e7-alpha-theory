theorem can3 : ∀ a b c : F3, Eqv (add3 a b) (add3 a c) → Eqv b c := (F3.rec (motive := fun a => ∀ b c : F3, Eqv (add3 a b) (add3 a c) → Eqv b c) ((F3.rec (motive := fun b => ∀ c : F3, Eqv (add3 F3.v0 b) (add3 F3.v0 c) → Eqv b c) ((F3.rec (motive := fun c => Eqv (add3 F3.v0 F3.v0) (add3 F3.v0 c) → Eqv F3.v0 c) (fun _ => Eqv.refl) (fun h => Void.rec (motive := fun _ => Eqv F3.v0 F3.v1) (neq3_0_1 h)) (fun h => Void.rec (motive := fun _ => Eqv F3.v0 F3.v2) (neq3_0_2 h)))) ((F3.rec (motive := fun c => Eqv (add3 F3.v0 F3.v1) (add3 F3.v0 c) → Eqv F3.v1 c) (fun h => Void.rec (motive := fun _ => Eqv F3.v1 F3.v0) (neq3_1_0 h)) (fun _ => Eqv.refl) (fun h => Void.rec (motive := fun _ => Eqv F3.v1 F3.v2) (neq3_1_2 h)))) ((F3.rec (motive := fun c => Eqv (add3 F3.v0 F3.v2) (add3 F3.v0 c) → Eqv F3.v2 c) (fun h => Void.rec (motive := fun _ => Eqv F3.v2 F3.v0) (neq3_2_0 h)) (fun h => Void.rec (motive := fun _ => Eqv F3.v2 F3.v1) (neq3_2_1 h)) (fun _ => Eqv.refl))))) ((F3.rec (motive := fun b => ∀ c : F3, Eqv (add3 F3.v1 b) (add3 F3.v1 c) → Eqv b c) ((F3.rec (motive := fun c => Eqv (add3 F3.v1 F3.v0) (add3 F3.v1 c) → Eqv F3.v0 c) (fun _ => Eqv.refl) (fun h => Void.rec (motive := fun _ => Eqv F3.v0 F3.v1) (neq3_1_2 h)) (fun h => Void.rec (motive := fun _ => Eqv F3.v0 F3.v2) (neq3_1_0 h)))) ((F3.rec (motive := fun c => Eqv (add3 F3.v1 F3.v1) (add3 F3.v1 c) → Eqv F3.v1 c) (fun h => Void.rec (motive := fun _ => Eqv F3.v1 F3.v0) (neq3_2_1 h)) (fun _ => Eqv.refl) (fun h => Void.rec (motive := fun _ => Eqv F3.v1 F3.v2) (neq3_2_0 h)))) ((F3.rec (motive := fun c => Eqv (add3 F3.v1 F3.v2) (add3 F3.v1 c) → Eqv F3.v2 c) (fun h => Void.rec (motive := fun _ => Eqv F3.v2 F3.v0) (neq3_0_1 h)) (fun h => Void.rec (motive := fun _ => Eqv F3.v2 F3.v1) (neq3_0_2 h)) (fun _ => Eqv.refl))))) ((F3.rec (motive := fun b => ∀ c : F3, Eqv (add3 F3.v2 b) (add3 F3.v2 c) → Eqv b c) ((F3.rec (motive := fun c => Eqv (add3 F3.v2 F3.v0) (add3 F3.v2 c) → Eqv F3.v0 c) (fun _ => Eqv.refl) (fun h => Void.rec (motive := fun